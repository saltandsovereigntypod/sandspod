# Cloudflare: how long browsers may keep the files in dist/ (the Worker sets its own).
# Pages, scripts and styles are checked again often, so a release shows up
# within minutes; pictures, sounds and fonts rarely change and are kept longer.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Scripts and styles: always checked (a quick "not modified" when unchanged),
# so a release never mixes a new file with an old one still in the browser.
/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The web app's built files (webapp/, scripts/build-webapp.mjs) carry their
# content hash in the name, so they never change: kept for a year.
/_expo/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/____app/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
