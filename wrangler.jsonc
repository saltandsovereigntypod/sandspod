// Cloudflare: the website. The build command (node scripts/cloudflare-build.mjs)
// copies the brand's static pages and the Expo web app's export (webapp/) into
// dist/, and `npx wrangler deploy` publishes them with the Worker
// (worker/index.js). A request for a file in dist/ is answered from it directly
// (_headers sets cache times); anything else reaches the Worker, which answers
// the app's addresses with the app's page and redirects the old website app
// pages to the app's addresses (worker/routing.js).
{
  "name": "saltandsovereignty",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  }
}
