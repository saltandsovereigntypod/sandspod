{
  "expo": {
    "name": "Salt & Sovereignty",
    "slug": "salt-and-sovereignty",
    "scheme": "saltandsovereignty",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c1510",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saltandsovereignty.app"
    },
    "android": {
      "package": "com.saltandsovereignty.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c1510",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0c1510"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "471363f9-07e8-452a-a759-08e390c44936"
      }
    }
  }
}
