{
  "expo": {
    "name": "Salt & Sovereignty",
    "slug": "ashley19175",
    "scheme": "saltandsovereignty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c1510",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saltandsovereignty.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.saltandsovereignty.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c1510",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0c1510",
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#0c1510"
          }
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow $(PRODUCT_NAME) to add your planned rituals, moon phases and sabbats to your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to work out sunrise, sunset, moonrise and planetary hours where you are. It stays on your phone."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.saltandsovereignty.app.widgets",
          "groupIdentifier": "group.com.saltandsovereignty.app",
          "widgets": [
            {
              "name": "MoonWidget",
              "displayName": "Tonight's Moon",
              "description": "The moon tonight, today's holiday and your next ritual.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use photos you choose for your own altar items and apothecary workings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08131a0f-a981-4de5-9def-e19761ca46ae"
      }
    },
    "owner": "ashley19175s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/08131a0f-a981-4de5-9def-e19761ca46ae"
    }
  }
}
