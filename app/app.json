{
  "expo": {
    "name": "Salt & Sovereignty",
    "slug": "ashley19175",
    "scheme": "saltandsovereignty",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c1510",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saltandsovereignty.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.saltandsovereignty.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0c1510"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow $(PRODUCT_NAME) to add your planned rituals, moon phases and sabbats to your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08131a0f-a981-4de5-9def-e19761ca46ae"
      }
    },
    "owner": "ashley19175s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/08131a0f-a981-4de5-9def-e19761ca46ae"
    }
  }
}
