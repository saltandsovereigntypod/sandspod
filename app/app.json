{
  "expo": {
    "name": "Salt & Sovereignty",
    "slug": "ashley19175",
    "scheme": "saltandsovereignty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c1510",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saltandsovereignty.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.saltandsovereignty.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c1510",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0c1510",
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true,
            "backgroundColor": "#0c1510"
          }
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow $(PRODUCT_NAME) to add your planned rituals, moon phases and sabbats to your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to work out sunrise, sunset, moonrise and planetary hours where you are. It stays on your phone."
        }
      ],
      [
        "./plugins/withWidgetDeploymentTarget",
        {
          "bundleIdentifier": "com.saltandsovereignty.app.widgets",
          "deploymentTarget": "17.0"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.saltandsovereignty.app.widgets",
          "groupIdentifier": "group.com.saltandsovereignty.app",
          "widgets": [
            {
              "name": "AltarWidget",
              "displayName": "Altar",
              "description": "One of your altars: light its candles, tend offerings and cleanse crystals from here.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "Which altar",
                  "description": "Choose which altar to show. In the app, open an altar and tap Home screen to choose its place.",
                  "parameters": {
                    "altar": {
                      "title": "Altar",
                      "type": "enum",
                      "default": "altar1",
                      "values": [
                        {
                          "name": "Altar 1",
                          "value": "altar1"
                        },
                        {
                          "name": "Altar 2",
                          "value": "altar2"
                        },
                        {
                          "name": "Altar 3",
                          "value": "altar3"
                        },
                        {
                          "name": "Altar 4",
                          "value": "altar4"
                        },
                        {
                          "name": "Altar 5",
                          "value": "altar5"
                        },
                        {
                          "name": "Altar 6",
                          "value": "altar6"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "MoonWidget",
              "displayName": "Tonight's Moon",
              "description": "The moon tonight; larger, with today's holiday and what it means.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "HolidayWidget",
              "displayName": "Next Holiday",
              "description": "A countdown to the next holiday in your calendars.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "ComingUpWidget",
              "displayName": "Coming Up",
              "description": "The next moon phases and holidays.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ]
              }
            },
            {
              "name": "RitualWidget",
              "displayName": "Next Ritual",
              "description": "Your next planned ritual; larger, with its intention and what you'll need.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to use photos you choose for your own altar items and apothecary workings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08131a0f-a981-4de5-9def-e19761ca46ae"
      }
    },
    "owner": "ashley19175s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/08131a0f-a981-4de5-9def-e19761ca46ae"
    }
  }
}
